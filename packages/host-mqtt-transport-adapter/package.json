{
  "name": "@tikkhun/host-mqtt-transport-adapter",
  "version": "0.0.0",
  "description": "Transport adapter for @tikkhun/host based on MQTT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx ./src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "host",
    "mqtt",
    "transport",
    "adapter"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "mqtt": "^5.14.0"
  },
  "peerDependencies": {
    "@tikkhun/host": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "tsx": "^4.19.1",
    "tsdown": "^0.12.2",
    "vitest": "^2.1.3"
  }
}
